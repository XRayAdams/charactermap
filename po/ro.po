msgid "Character Information"
msgstr "Informații despre caracter"

#: src/app.rs:753
msgid "Jump to Unicode Set"
msgstr "Salt la setul Unicode"

#: src/app.rs:783
msgid "double click character to add here"
msgstr "faceți dublu clic pe un caracter pentru a-l adăuga aici"

#: src/app.rs:810
msgid "Hex:"
msgstr "Hex:"

#: src/app.rs:836
msgid "Dec:"
msgstr "Zec:"

#: src/app.rs:873 src/app.rs:1228
msgid "Save Character as Image"
msgstr "Salvează caracterul ca imagine"

#: src/app.rs:1210
msgid "Copied to clipboard"
msgstr "Copiat în clipboard"

#: src/app.rs:1223
msgid "PNG images"
msgstr "Imagini PNG"

#: src/app.rs:1241
msgid "Character saved as image"
msgstr "Caracterul a fost salvat ca imagine"

#: src/app.rs:1242
msgid "Could not save the image"
msgstr "Imaginea nu a putut fi salvată"

#: src/helpers/static_data.rs:6
msgid "Character Map"
msgstr "Tabel de caractere"

#: src/templates/char_find_entry.rs:31
msgid "Find"
msgstr "Caută"

#: src/templates/filter_switch.rs:21
msgid "Filter Unicode pages"
msgstr "Filtrează paginile Unicode"

#: src/templates/filter_switch.rs:27
msgid "Show only Unicode blocks the selected font supports"
msgstr "Afișează doar blocurile Unicode acceptate de fontul selectat"

#: src/templates/font_preview_toggle.rs:19
msgid "Show plain font names"
msgstr "Afișează numele simple ale fonturilor"

#: src/templates/font_preview_toggle.rs:25
msgid "Preview names using each font"
msgstr "Previzualizează numele folosind fiecare font"

#: src/widgets/help_dialog.rs:25
msgid "Font List"
msgstr "Lista fonturilor"

#: src/widgets/help_dialog.rs:27 src/widgets/help_dialog.rs:34
msgid "Use the arrow keys to move the selection."
msgstr "Folosiți tastele săgeți pentru a muta selecția."

#: src/widgets/help_dialog.rs:28
msgid "Start typing to find a font by name."
msgstr "Începeți să tastați pentru a găsi un font după nume."

#: src/widgets/help_dialog.rs:32
msgid "Grid"
msgstr "Grilă"

#: src/widgets/help_dialog.rs:35
msgid ""
"Double-click, or press Enter, to add the selected character to the "
"collection box."
msgstr ""
"Faceți dublu clic sau apăsați Enter pentru a adăuga caracterul selectat în "
"caseta de colecție."

#: src/widgets/help_dialog.rs:36
msgid "Press Ctrl+C to copy the selected character to the clipboard."
msgstr "Apăsați Ctrl+C pentru a copia caracterul selectat în clipboard."

#: src/widgets/help_dialog.rs:37
msgid ""
"If a character is not present in the selected font, it will be shown as a "
"tofu box with a different background."
msgstr ""
"Dacă un caracter nu este prezent în fontul selectat, acesta va fi afișat ca "
"un dreptunghi gol (tofu) cu un fundal diferit."

#: src/widgets/help_dialog.rs:41
msgid "Hex and Dec Entries"
msgstr "Câmpuri hexazecimal și zecimal"

#: src/widgets/help_dialog.rs:42
msgid ""
"Enter a hex value or a decimal value, then press Enter to find the character."
msgstr ""
"Introduceți o valoare hexazecimală sau o valoare zecimală, apoi apăsați "
"Enter pentru a găsi caracterul."

#: src/widgets/help_dialog.rs:46
msgid "Click the save icon to save the selected character as a PNG image."
msgstr "Faceți clic pe pictograma de salvare pentru a salva caracterul selectat ca imagine PNG."

#: src/widgets/help_dialog.rs:49
msgid "Search"
msgstr "Căutare"

#: src/widgets/help_dialog.rs:51
msgid "Click the search icon to open the search bar."
msgstr ""
"Faceți clic pe pictograma de căutare pentru a deschide bara de căutare."

#: src/widgets/help_dialog.rs:52
msgid "Type a character's name to find every character whose name contains it."
msgstr ""
"Tastați numele unui caracter pentru a găsi toate caracterele al căror nume "
"îl conține."

#: src/widgets/help_dialog.rs:53
msgid "Type, or paste, a single character to find it directly."
msgstr "Tastați sau lipiți un singur caracter pentru a-l găsi direct."

#: src/widgets/help_dialog.rs:92
msgid "Help"
msgstr "Ajutor"
