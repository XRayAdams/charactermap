msgid "Search results ({})"
msgstr "Zoekresultaten ({})"

#: src/app.rs:514
msgid "_Help"
msgstr "_Hulp"

#: src/app.rs:515
msgid "_About"
msgstr "_Over"

#: src/app.rs:539
msgid "Fonts"
msgstr "Lettertypen"

#: src/app.rs:559
msgid "Search fonts…"
msgstr "Lettertypen zoeken…"

#: src/app.rs:641
msgid "Single letter or character name"
msgstr "Enkele letter of tekennaam"

#: src/app.rs:727
msgid "Character Information"
msgstr "Tekeninformatie"

#: src/app.rs:743
msgid "Jump to Unicode Set"
msgstr "Naar Unicode-bereik springen"

#: src/app.rs:773
msgid "double click character to add here"
msgstr "dubbelklik op een teken om het hier toe te voegen"

#: src/app.rs:800
msgid "Hex:"
msgstr "Hex:"

#: src/app.rs:826
msgid "Dec:"
msgstr "Dec:"

#: src/app.rs:1181
msgid "Copied to clipboard"
msgstr "Naar klembord gekopieerd"

#: src/templates/char_find_entry.rs:31
msgid "Find"
msgstr "Zoeken"

#: src/templates/filter_switch.rs:21
msgid "Filter Unicode pages"
msgstr "Unicode-pagina's filteren"

#: src/templates/filter_switch.rs:27
msgid "Show only Unicode blocks the selected font supports"
msgstr "Alleen Unicode-blokken tonen die het geselecteerde lettertype ondersteunt"

#: src/templates/font_preview_toggle.rs:19
msgid "Show plain font names"
msgstr "Eenvoudige lettertypenamen tonen"

#: src/templates/font_preview_toggle.rs:25
msgid "Preview names using each font"
msgstr "Namen weergeven in het bijbehorende lettertype"

#: src/widgets/help_dialog.rs:25
msgid "Font List"
msgstr "Lettertypelijst"

#: src/widgets/help_dialog.rs:27 src/widgets/help_dialog.rs:34
msgid "Use the arrow keys to move the selection."
msgstr "Gebruik de pijltjestoetsen om de selectie te verplaatsen."

#: src/widgets/help_dialog.rs:28
msgid "Start typing to find a font by name."
msgstr "Begin met typen om een lettertype op naam te zoeken."

#: src/widgets/help_dialog.rs:32
msgid "Grid"
msgstr "Raster"

#: src/widgets/help_dialog.rs:35
msgid ""
"Double-click, or press Enter, to add the selected character to the "
"collection box."
msgstr ""
"Dubbelklik, of druk op Enter, om het geselecteerde teken toe te voegen aan "
"het verzamelvak."

#: src/widgets/help_dialog.rs:36
msgid "Press Ctrl+C to copy the selected character to the clipboard."
msgstr ""
"Druk op Ctrl+C om het geselecteerde teken naar het klembord te kopiëren."

#: src/widgets/help_dialog.rs:37
msgid ""
"If a character is not present in the selected font, it will be shown as a "
"tofu box with a different background."
msgstr ""
"Als een teken niet aanwezig is in het geselecteerde lettertype, wordt het "
"weergegeven als een tofu-vakje met een andere achtergrond."

#: src/widgets/help_dialog.rs:41
msgid "Hex and Dec Entries"
msgstr "Hex- en decimale velden"

#: src/widgets/help_dialog.rs:42
msgid ""
"Enter a hex value, a decimal value, or a character, then press Enter to find "
"it."
msgstr ""
"Voer een hexadecimale waarde, een decimale waarde of een teken in en druk "
"op Enter om het te vinden."

#: src/widgets/help_dialog.rs:45
msgid "Search"
msgstr "Zoeken"

#: src/widgets/help_dialog.rs:47
msgid "Click the search icon to open the search bar."
msgstr "Klik op het zoekpictogram om de zoekbalk te openen."

#: src/widgets/help_dialog.rs:48
msgid "Type a character's name to find every character whose name contains it."
msgstr ""
"Typ de naam van een teken om elk teken te vinden waarvan de naam deze "
"bevat."

#: src/widgets/help_dialog.rs:49
msgid "Type, or paste, a single character to find it directly."
msgstr ""
"Typ of plak een enkel teken om het direct te vinden."

#: src/widgets/help_dialog.rs:88
msgid "Help"
msgstr "Hulp"
