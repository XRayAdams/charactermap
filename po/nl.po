msgid "Character Information"
msgstr "Tekeninformatie"

#: src/app.rs:769
msgid "Jump to Unicode Set"
msgstr "Naar Unicode-bereik springen"

#: src/app.rs:799
msgid "double click character to add here"
msgstr "dubbelklik op een teken om het hier toe te voegen"

#: src/app.rs:826
msgid "Hex:"
msgstr "Hex:"

#: src/app.rs:852
msgid "Dec:"
msgstr "Dec:"

