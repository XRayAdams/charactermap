#: src/app.rs:477
msgid "Fonts"
msgstr "Tipi di carattere"

#: src/app.rs:497
msgid "Search fonts…"
msgstr "Cerca tipi di carattere…"

#: src/app.rs:509
msgid "Show plain font names"
msgstr "Mostra i nomi dei tipi di carattere semplici"

#: src/app.rs:522
msgid "Preview names using each font"
msgstr "Anteprima dei nomi con ogni tipo di carattere"

#: src/app.rs:567
msgid "Filter Unicode pages"
msgstr "Filtra pagine Unicode"

#: src/app.rs:574
msgid "Show only Unicode blocks the selected font supports"
msgstr "Mostra solo i blocchi Unicode supportati dal tipo di carattere selezionato"

#: src/app.rs:596
msgid "Single letter or character name"
msgstr "Singola lettera o nome del carattere"

#: src/app.rs:688
msgid "Character Information"
msgstr "Informazioni sul carattere"

#: src/app.rs:704
msgid "Jump to Unicode Set"
msgstr "Vai a un insieme Unicode"

#: src/app.rs:732
msgid "double click character to add here"
msgstr "fai doppio clic su un carattere per aggiungerlo qui"

#: src/app.rs:757
msgid "Hex:"
msgstr "Hex:"

#: src/app.rs:775 src/app.rs:808
msgid "Find"
msgstr "Trova"

#: src/app.rs:790
msgid "Dec:"
msgstr "Dec:"

#: src/widgets/help_dialog.rs:25
msgid "Font List"
msgstr "Elenco dei tipi di carattere"

#: src/widgets/help_dialog.rs:27 src/widgets/help_dialog.rs:34
msgid "Use the arrow keys to move the selection."
msgstr "Usa i tasti freccia per spostare la selezione."

#: src/widgets/help_dialog.rs:28
msgid "Start typing to find a font by name."
msgstr "Inizia a digitare per trovare un tipo di carattere per nome."

#: src/widgets/help_dialog.rs:32
msgid "Grid"
msgstr "Griglia"

#: src/widgets/help_dialog.rs:35
msgid ""
"Double-click, or press Enter, to add the selected character to the "
"collection box."
msgstr ""
"Fai doppio clic, o premi Invio, per aggiungere il carattere selezionato al "
"riquadro di raccolta."

#: src/widgets/help_dialog.rs:36
msgid ""
"If a character is not present in the selected font, it will be shown as a "
"tofu box."
msgstr ""
"Se un carattere non è presente nel tipo di carattere selezionato, verrà "
"mostrato come un riquadro tofu."

#: src/widgets/help_dialog.rs:40
msgid "Hex and Dec Entries"
msgstr "Campi esadecimale e decimale"

#: src/widgets/help_dialog.rs:41
msgid ""
"Enter a hex value, a decimal value, or a character, then press Enter to find "
"it."
msgstr ""
"Inserisci un valore esadecimale, un valore decimale o un carattere, quindi "
"premi Invio per trovarlo."

#: src/widgets/help_dialog.rs:44
msgid "Search"
msgstr "Cerca"

#: src/widgets/help_dialog.rs:46
msgid "Click the search icon to open the search bar."
msgstr "Fai clic sull'icona di ricerca per aprire la barra di ricerca."

#: src/widgets/help_dialog.rs:47
msgid "Type a character's name to find every character whose name contains it."
msgstr ""
"Digita il nome di un carattere per trovare tutti i caratteri il cui nome "
"lo contiene."

#: src/widgets/help_dialog.rs:48
msgid "Type, or paste, a single character to find it directly."
msgstr "Digita, o incolla, un singolo carattere per trovarlo direttamente."

#: src/widgets/help_dialog.rs:87
msgid "Help"
msgstr "Aiuto"
