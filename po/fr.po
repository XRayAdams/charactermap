#: src/app.rs:477
msgid "Fonts"
msgstr "Polices"

#: src/app.rs:497
msgid "Search fonts…"
msgstr "Rechercher des polices…"

#: src/app.rs:509
msgid "Show plain font names"
msgstr "Afficher les noms de police en texte brut"

#: src/app.rs:522
msgid "Preview names using each font"
msgstr "Aperçu des noms avec chaque police"

#: src/app.rs:567
msgid "Filter Unicode pages"
msgstr "Filtrer les pages Unicode"

#: src/app.rs:574
msgid "Show only Unicode blocks the selected font supports"
msgstr "Afficher uniquement les blocs Unicode pris en charge par la police sélectionnée"

#: src/app.rs:596
msgid "Single letter or character name"
msgstr "Une seule lettre ou un nom de caractère"

#: src/app.rs:688
msgid "Character Information"
msgstr "Informations sur le caractère"

#: src/app.rs:704
msgid "Jump to Unicode Set"
msgstr "Aller à un ensemble Unicode"

#: src/app.rs:732
msgid "double click character to add here"
msgstr "double-cliquez sur un caractère pour l'ajouter ici"

#: src/app.rs:757
msgid "Hex:"
msgstr "Hex :"

#: src/app.rs:775 src/app.rs:808
msgid "Find"
msgstr "Rechercher"

#: src/app.rs:790
