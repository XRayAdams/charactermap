msgstr "À _propos"

#: src/app.rs:539
msgid "Fonts"
msgstr "Polices"

#: src/app.rs:559
msgid "Search fonts…"
msgstr "Rechercher des polices…"

#: src/app.rs:641
msgid "Single letter or character name"
msgstr "Une seule lettre ou un nom de caractère"

#: src/app.rs:727
msgid "Character Information"
msgstr "Informations sur le caractère"

#: src/app.rs:743
msgid "Jump to Unicode Set"
msgstr "Aller à un ensemble Unicode"

#: src/app.rs:773
msgid "double click character to add here"
msgstr "double-cliquez sur un caractère pour l'ajouter ici"

#: src/app.rs:800
msgid "Hex:"
msgstr "Hex :"

#: src/app.rs:826
msgid "Dec:"
msgstr "Déc :"

#: src/app.rs:1181
msgid "Copied to clipboard"
msgstr "Copié dans le presse-papiers"

#: src/templates/char_find_entry.rs:31
msgid "Find"
msgstr "Rechercher"

#: src/templates/filter_switch.rs:21
msgid "Filter Unicode pages"
msgstr "Filtrer les pages Unicode"

#: src/templates/filter_switch.rs:27
msgid "Show only Unicode blocks the selected font supports"
msgstr ""
"Afficher uniquement les blocs Unicode pris en charge par la police "
"sélectionnée"

#: src/templates/font_preview_toggle.rs:19
msgid "Show plain font names"
msgstr "Afficher les noms de police en texte brut"

#: src/templates/font_preview_toggle.rs:25
msgid "Preview names using each font"
msgstr "Aperçu des noms avec chaque police"

#: src/widgets/help_dialog.rs:25
msgid "Font List"
msgstr "Liste des polices"

#: src/widgets/help_dialog.rs:27 src/widgets/help_dialog.rs:34
msgid "Use the arrow keys to move the selection."
msgstr "Utilisez les touches fléchées pour déplacer la sélection."

#: src/widgets/help_dialog.rs:28
msgid "Start typing to find a font by name."
msgstr "Commencez à taper pour trouver une police par son nom."

#: src/widgets/help_dialog.rs:32
msgid "Grid"
msgstr "Grille"

#: src/widgets/help_dialog.rs:35
msgid ""
"Double-click, or press Enter, to add the selected character to the "
"collection box."
msgstr ""
"Double-cliquez, ou appuyez sur Entrée, pour ajouter le caractère sélectionné "
"à la zone de collecte."

#: src/widgets/help_dialog.rs:36
msgid "Press Ctrl+C to copy the selected character to the clipboard."
msgstr ""
"Appuyez sur Ctrl+C pour copier le caractère sélectionné dans le presse-"
"papiers."

#: src/widgets/help_dialog.rs:37
msgid ""
"If a character is not present in the selected font, it will be shown as a "
"tofu box with a different background."
msgstr ""
"Si un caractère n'est pas présent dans la police sélectionnée, il sera "
"affiché sous forme de carré tofu avec un arrière-plan différent."

#: src/widgets/help_dialog.rs:41
msgid "Hex and Dec Entries"
msgstr "Champs hexadécimal et décimal"

#: src/widgets/help_dialog.rs:42
msgid ""
"Enter a hex value, a decimal value, or a character, then press Enter to find "
"it."
msgstr ""
"Saisissez une valeur hexadécimale, une valeur décimale ou un caractère, puis "
"appuyez sur Entrée pour le trouver."

#: src/widgets/help_dialog.rs:45
msgid "Search"
msgstr "Recherche"

#: src/widgets/help_dialog.rs:47
msgid "Click the search icon to open the search bar."
msgstr "Cliquez sur l'icône de recherche pour ouvrir la barre de recherche."

#: src/widgets/help_dialog.rs:48
msgid "Type a character's name to find every character whose name contains it."
msgstr ""
"Tapez le nom d'un caractère pour trouver tous les caractères dont le nom le "
"contient."

#: src/widgets/help_dialog.rs:49
msgid "Type, or paste, a single character to find it directly."
msgstr "Tapez, ou collez, un seul caractère pour le trouver directement."

#: src/widgets/help_dialog.rs:88
msgid "Help"
msgstr "Aide"
