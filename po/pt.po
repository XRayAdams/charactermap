#: src/app.rs:433
#, rust-format
msgid "Search results ({})"
msgstr "Resultados da pesquisa ({})"

#: src/app.rs:501
msgid "_Help"
msgstr "_Ajuda"

#: src/app.rs:502
msgid "_About"
msgstr "_Sobre"

#: src/app.rs:526
msgid "Fonts"
msgstr "Fontes"

#: src/app.rs:546
msgid "Search fonts…"
msgstr "Pesquisar fontes…"

#: src/app.rs:558
msgid "Show plain font names"
msgstr "Mostrar nomes de fontes simples"

#: src/app.rs:571
msgid "Preview names using each font"
msgstr "Pré-visualizar nomes usando cada fonte"

#: src/app.rs:616
msgid "Filter Unicode pages"
msgstr "Filtrar páginas Unicode"

#: src/app.rs:623
msgid "Show only Unicode blocks the selected font supports"
msgstr "Mostrar apenas os blocos Unicode suportados pela fonte selecionada"

#: src/app.rs:645
msgid "Single letter or character name"
msgstr "Uma única letra ou nome de caractere"

#: src/app.rs:734
msgid "Character Information"
msgstr "Informação do caractere"

#: src/app.rs:750
msgid "Jump to Unicode Set"
msgstr "Ir para um conjunto Unicode"

#: src/app.rs:778
msgid "double click character to add here"
msgstr "clique duas vezes no caractere para adicioná-lo aqui"

#: src/app.rs:803
msgid "Hex:"
msgstr "Hex:"

#: src/app.rs:821 src/app.rs:854
msgid "Find"
msgstr "Localizar"

#: src/app.rs:836
msgid "Dec:"
msgstr "Dec:"

#: src/app.rs:1203
msgid "Copied to clipboard"
msgstr "Copiado para a área de transferência"

#: src/widgets/help_dialog.rs:25
msgid "Font List"
msgstr "Lista de fontes"

#: src/widgets/help_dialog.rs:27 src/widgets/help_dialog.rs:34
msgid "Use the arrow keys to move the selection."
msgstr "Use as teclas de seta para mover a seleção."

#: src/widgets/help_dialog.rs:28
msgid "Start typing to find a font by name."
msgstr "Comece a digitar para encontrar uma fonte pelo nome."

#: src/widgets/help_dialog.rs:32
msgid "Grid"
msgstr "Grade"

#: src/widgets/help_dialog.rs:35
msgid ""
"Double-click, or press Enter, to add the selected character to the "
"collection box."
msgstr ""
"Clique duas vezes, ou pressione Enter, para adicionar o caractere "
"selecionado à caixa de coleta."

#: src/widgets/help_dialog.rs:36
msgid "Press Ctrl+C to copy the selected character to the clipboard."
msgstr "Pressione Ctrl+C para copiar o caractere selecionado para a área de transferência."

#: src/widgets/help_dialog.rs:37
msgid ""
"If a character is not present in the selected font, it will be shown as a "
"tofu box."
msgstr ""
"Se um caractere não estiver presente na fonte selecionada, ele será exibido "
"como uma caixa tofu."

#: src/widgets/help_dialog.rs:41
msgid "Hex and Dec Entries"
msgstr "Campos hexadecimal e decimal"

#: src/widgets/help_dialog.rs:42
msgid ""
"Enter a hex value, a decimal value, or a character, then press Enter to find "
"it."
msgstr ""
"Digite um valor hexadecimal, um valor decimal ou um caractere e pressione "
"Enter para encontrá-lo."

#: src/widgets/help_dialog.rs:45
msgid "Search"
msgstr "Pesquisar"

#: src/widgets/help_dialog.rs:47
msgid "Click the search icon to open the search bar."
msgstr "Clique no ícone de pesquisa para abrir a barra de pesquisa."

#: src/widgets/help_dialog.rs:48
msgid "Type a character's name to find every character whose name contains it."
msgstr ""
"Digite o nome de um caractere para encontrar todos os caracteres cujo nome o "
"contenha."

#: src/widgets/help_dialog.rs:49
msgid "Type, or paste, a single character to find it directly."
msgstr "Digite, ou cole, um único caractere para encontrá-lo diretamente."

#: src/widgets/help_dialog.rs:88
msgid "Help"
msgstr "Ajuda"
