msgstr "Guardar carácter como imagen"

#: src/app.rs:1299
msgid "Copied to clipboard"
msgstr "Copiado al portapapeles"

#: src/app.rs:1312
msgid "PNG images"
msgstr "Imágenes PNG"

#: src/app.rs:1330
msgid "Character saved as image"
msgstr "Carácter guardado como imagen"

#: src/app.rs:1331
