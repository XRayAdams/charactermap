msgstr "_Acerca de"

#: src/app.rs:539
msgid "Fonts"
msgstr "Fuentes"

#: src/app.rs:559
msgid "Search fonts…"
msgstr "Buscar fuentes…"

#: src/app.rs:641
msgid "Single letter or character name"
msgstr "Una sola letra o nombre de carácter"

#: src/app.rs:727
msgid "Character Information"
msgstr "Información del carácter"

#: src/app.rs:743
msgid "Jump to Unicode Set"
msgstr "Ir a un conjunto Unicode"

#: src/app.rs:773
msgid "double click character to add here"
msgstr "haz doble clic en un carácter para añadirlo aquí"

#: src/app.rs:800
msgid "Hex:"
msgstr "Hex:"

#: src/app.rs:826
msgid "Dec:"
msgstr "Dec:"

#: src/app.rs:1181
msgid "Copied to clipboard"
msgstr "Copiado al portapapeles"

#: src/templates/char_find_entry.rs:31
msgid "Find"
msgstr "Buscar"

#: src/templates/filter_switch.rs:21
msgid "Filter Unicode pages"
msgstr "Filtrar páginas Unicode"

#: src/templates/filter_switch.rs:27
msgid "Show only Unicode blocks the selected font supports"
msgstr "Mostrar solo los bloques Unicode admitidos por la fuente seleccionada"

#: src/templates/font_preview_toggle.rs:19
msgid "Show plain font names"
msgstr "Mostrar nombres de fuente sin formato"

#: src/templates/font_preview_toggle.rs:25
msgid "Preview names using each font"
msgstr "Previsualizar los nombres usando cada fuente"

#: src/widgets/help_dialog.rs:25
msgid "Font List"
msgstr "Lista de fuentes"

#: src/widgets/help_dialog.rs:27 src/widgets/help_dialog.rs:34
msgid "Use the arrow keys to move the selection."
msgstr "Usa las teclas de flecha para mover la selección."

#: src/widgets/help_dialog.rs:28
msgid "Start typing to find a font by name."
msgstr "Empieza a escribir para buscar una fuente por su nombre."

#: src/widgets/help_dialog.rs:32
msgid "Grid"
msgstr "Cuadrícula"

#: src/widgets/help_dialog.rs:35
msgid ""
"Double-click, or press Enter, to add the selected character to the "
"collection box."
msgstr ""
"Haz doble clic, o pulsa Intro, para añadir el carácter seleccionado al "
"cuadro de recopilación."

#: src/widgets/help_dialog.rs:36
msgid "Press Ctrl+C to copy the selected character to the clipboard."
msgstr "Pulsa Ctrl+C para copiar el carácter seleccionado al portapapeles."

#: src/widgets/help_dialog.rs:37
msgid ""
"If a character is not present in the selected font, it will be shown as a "
"tofu box with a different background."
msgstr ""
"Si un carácter no está presente en la fuente seleccionada, se mostrará como "
"un cuadro tofu con un fondo diferente."

#: src/widgets/help_dialog.rs:41
msgid "Hex and Dec Entries"
msgstr "Campos hexadecimal y decimal"

#: src/widgets/help_dialog.rs:42
msgid ""
"Enter a hex value, a decimal value, or a character, then press Enter to find "
"it."
msgstr ""
"Introduce un valor hexadecimal, un valor decimal o un carácter, y pulsa "
"Intro para encontrarlo."

#: src/widgets/help_dialog.rs:45
msgid "Search"
msgstr "Buscar"

#: src/widgets/help_dialog.rs:47
msgid "Click the search icon to open the search bar."
msgstr "Haz clic en el icono de búsqueda para abrir la barra de búsqueda."

#: src/widgets/help_dialog.rs:48
msgid "Type a character's name to find every character whose name contains it."
msgstr ""
"Escribe el nombre de un carácter para encontrar todos los que lo contengan."

#: src/widgets/help_dialog.rs:49
msgid "Type, or paste, a single character to find it directly."
msgstr "Escribe o pega un solo carácter para encontrarlo directamente."

#: src/widgets/help_dialog.rs:88
msgid "Help"
msgstr "Ayuda"
