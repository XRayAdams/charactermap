#: src/app.rs:497
msgid "Search fonts…"
msgstr "Buscar fuentes…"

#: src/app.rs:509
msgid "Show plain font names"
msgstr "Mostrar nombres de fuente sin formato"

#: src/app.rs:522
msgid "Preview names using each font"
msgstr "Previsualizar los nombres usando cada fuente"

#: src/app.rs:567
msgid "Filter Unicode pages"
msgstr "Filtrar páginas Unicode"

