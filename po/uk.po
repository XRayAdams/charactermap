#: src/app.rs:433
#, rust-format
msgid "Search results ({})"
msgstr "Результати пошуку ({})"

#: src/app.rs:501
msgid "_Help"
msgstr "_Довідка"

#: src/app.rs:502
msgid "_About"
msgstr "_Про програму"

#: src/app.rs:526
msgid "Fonts"
msgstr "Шрифти"

#: src/app.rs:546
msgid "Search fonts…"
msgstr "Пошук шрифтів…"

#: src/app.rs:558
msgid "Show plain font names"
msgstr "Показувати звичайні назви шрифтів"

#: src/app.rs:571
msgid "Preview names using each font"
msgstr "Попередній перегляд назв кожним шрифтом"

#: src/app.rs:616
msgid "Filter Unicode pages"
msgstr "Фільтрувати сторінки Юнікоду"

#: src/app.rs:623
msgid "Show only Unicode blocks the selected font supports"
msgstr "Показувати лише блоки Юнікоду, які підтримує вибраний шрифт"

#: src/app.rs:645
msgid "Single letter or character name"
msgstr "Одна літера або назва символу"

#: src/app.rs:734
msgid "Character Information"
msgstr "Інформація про символ"

#: src/app.rs:750
msgid "Jump to Unicode Set"
msgstr "Перейти до набору Юнікоду"

#: src/app.rs:778
msgid "double click character to add here"
msgstr "двічі клацніть символ, щоб додати його сюди"

#: src/app.rs:803
msgid "Hex:"
msgstr "Шістн.:"

#: src/app.rs:821 src/app.rs:854
msgid "Find"
msgstr "Знайти"

#: src/app.rs:836
msgid "Dec:"
msgstr "Десятк.:"

#: src/app.rs:1203
msgid "Copied to clipboard"
msgstr "Скопійовано в буфер обміну"

#: src/widgets/help_dialog.rs:25
msgid "Font List"
msgstr "Список шрифтів"

#: src/widgets/help_dialog.rs:27 src/widgets/help_dialog.rs:34
msgid "Use the arrow keys to move the selection."
msgstr "Використовуйте клавіші зі стрілками для переміщення виділення."

#: src/widgets/help_dialog.rs:28
msgid "Start typing to find a font by name."
msgstr "Почніть вводити текст, щоб знайти шрифт за назвою."

#: src/widgets/help_dialog.rs:32
msgid "Grid"
msgstr "Сітка"

#: src/widgets/help_dialog.rs:35
msgid ""
"Double-click, or press Enter, to add the selected character to the "
"collection box."
msgstr ""
"Двічі клацніть або натисніть Enter, щоб додати вибраний символ до поля збору."

#: src/widgets/help_dialog.rs:36
msgid "Press Ctrl+C to copy the selected character to the clipboard."
msgstr "Натисніть Ctrl+C, щоб скопіювати вибраний символ у буфер обміну."

#: src/widgets/help_dialog.rs:37
msgid ""
"If a character is not present in the selected font, it will be shown as a "
"tofu box."
msgstr ""
"Якщо символ відсутній у вибраному шрифті, він відображатиметься як порожній "
"прямокутник (тофу)."

#: src/widgets/help_dialog.rs:41
msgid "Hex and Dec Entries"
msgstr "Шістнадцяткове та десяткове поля"

#: src/widgets/help_dialog.rs:42
msgid ""
"Enter a hex value, a decimal value, or a character, then press Enter to find "
"it."
msgstr ""
"Введіть шістнадцяткове значення, десяткове значення або символ, а потім "
"натисніть Enter, щоб знайти його."

#: src/widgets/help_dialog.rs:45
msgid "Search"
msgstr "Пошук"

#: src/widgets/help_dialog.rs:47
msgid "Click the search icon to open the search bar."
msgstr "Натисніть піктограму пошуку, щоб відкрити панель пошуку."

#: src/widgets/help_dialog.rs:48
msgid "Type a character's name to find every character whose name contains it."
msgstr "Введіть назву символу, щоб знайти всі символи, назва яких її містить."

#: src/widgets/help_dialog.rs:49
msgid "Type, or paste, a single character to find it directly."
msgstr "Введіть або вставте один символ, щоб знайти його безпосередньо."

#: src/widgets/help_dialog.rs:88
msgid "Help"
msgstr "Довідка"
