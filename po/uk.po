#: src/app.rs:733 src/widgets/help_dialog.rs:45
msgid "Character Information"
msgstr "Інформація про символ"

#: src/app.rs:753
msgid "Jump to Unicode Set"
msgstr "Перейти до набору Юнікоду"

#: src/app.rs:783
