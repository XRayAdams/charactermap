#: src/app.rs:446
#, rust-format
msgid "Search results ({})"
msgstr "Výsledky vyhľadávania ({})"

#: src/app.rs:516
msgid "_Help"
msgstr "_Pomocník"

#: src/app.rs:517
msgid "_About"
msgstr "_O aplikácii"

#: src/app.rs:541
msgid "Fonts"
msgstr "Písma"

#: src/app.rs:561
msgid "Search fonts…"
msgstr "Hľadať písma…"

#: src/app.rs:643
msgid "Single letter or character name"
msgstr "Jedno písmeno alebo názov znaku"

#: src/app.rs:729
msgid "Character Information"
msgstr "Informácie o znaku"

#: src/app.rs:745
msgid "Jump to Unicode Set"
msgstr "Prejsť na sadu Unicode"

#: src/app.rs:775
msgid "double click character to add here"
msgstr "dvojitým kliknutím na znak ho pridáte sem"

#: src/app.rs:802
msgid "Hex:"
msgstr "Hex.:"

#: src/app.rs:828
msgid "Dec:"
msgstr "Dec.:"

#: src/app.rs:1183
msgid "Copied to clipboard"
msgstr "Skopírované do schránky"

#: src/helpers/static_data.rs:6
msgid "Character Map"
msgstr "Tabuľka znakov"

#: src/templates/char_find_entry.rs:31
msgid "Find"
msgstr "Nájsť"

#: src/templates/filter_switch.rs:21
msgid "Filter Unicode pages"
msgstr "Filtrovať stránky Unicode"

#: src/templates/filter_switch.rs:27
msgid "Show only Unicode blocks the selected font supports"
msgstr "Zobraziť iba bloky Unicode, ktoré vybrané písmo podporuje"

#: src/templates/font_preview_toggle.rs:19
msgid "Show plain font names"
msgstr "Zobraziť obyčajné názvy písiem"

#: src/templates/font_preview_toggle.rs:25
msgid "Preview names using each font"
msgstr "Ukážka názvov pomocou každého písma"

#: src/widgets/help_dialog.rs:25
msgid "Font List"
msgstr "Zoznam písiem"

#: src/widgets/help_dialog.rs:27 src/widgets/help_dialog.rs:34
msgid "Use the arrow keys to move the selection."
msgstr "Na presun výberu použite klávesy so šípkami."

#: src/widgets/help_dialog.rs:28
msgid "Start typing to find a font by name."
msgstr "Začnite písať a nájdete písmo podľa názvu."

#: src/widgets/help_dialog.rs:32
msgid "Grid"
msgstr "Mriežka"

#: src/widgets/help_dialog.rs:35
msgid ""
"Double-click, or press Enter, to add the selected character to the "
"collection box."
msgstr ""
"Dvojitým kliknutím alebo stlačením Enter pridáte vybraný znak do zbernej "
"schránky."

#: src/widgets/help_dialog.rs:36
msgid "Press Ctrl+C to copy the selected character to the clipboard."
msgstr "Stlačením Ctrl+C skopírujete vybraný znak do schránky."

#: src/widgets/help_dialog.rs:37
msgid ""
"If a character is not present in the selected font, it will be shown as a "
"tofu box with a different background."
msgstr ""
"Ak sa znak vo vybranom písme nenachádza, zobrazí sa ako prázdny obdĺžnik "
"(tofu) s odlišným pozadím."

#: src/widgets/help_dialog.rs:41
msgid "Hex and Dec Entries"
msgstr "Hexadecimálne a desiatkové polia"

#: src/widgets/help_dialog.rs:42
msgid ""
"Enter a hex value or a decimal value, then press Enter to find the character."
msgstr ""
"Zadajte hexadecimálnu alebo desiatkovú hodnotu a potom stlačte Enter na "
"nájdenie znaku."

#: src/widgets/help_dialog.rs:45
msgid "Search"
msgstr "Hľadať"

#: src/widgets/help_dialog.rs:47
msgid "Click the search icon to open the search bar."
msgstr "Kliknutím na ikonu vyhľadávania otvoríte vyhľadávací panel."

#: src/widgets/help_dialog.rs:48
msgid "Type a character's name to find every character whose name contains it."
msgstr "Zadajte názov znaku a nájdete všetky znaky, ktorých názov ho obsahuje."

#: src/widgets/help_dialog.rs:49
msgid "Type, or paste, a single character to find it directly."
msgstr "Zadajte alebo vložte jeden znak, aby ste ho našli priamo."

#: src/widgets/help_dialog.rs:88
msgid "Help"
msgstr "Pomocník"
