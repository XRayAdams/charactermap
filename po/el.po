#: src/app.rs:446
#, rust-format
msgid "Search results ({})"
msgstr "Αποτελέσματα αναζήτησης ({})"

#: src/app.rs:514
msgid "_Help"
msgstr "_Βοήθεια"

#: src/app.rs:515
msgid "_About"
msgstr "_Πληροφορίες"

#: src/app.rs:539
msgid "Fonts"
msgstr "Γραμματοσειρές"

#: src/app.rs:559
msgid "Search fonts…"
msgstr "Αναζήτηση γραμματοσειρών…"

#: src/app.rs:641
msgid "Single letter or character name"
msgstr "Ένα γράμμα ή όνομα χαρακτήρα"

#: src/app.rs:727
msgid "Character Information"
msgstr "Πληροφορίες χαρακτήρα"

#: src/app.rs:743
msgid "Jump to Unicode Set"
msgstr "Μετάβαση σε σύνολο Unicode"

#: src/app.rs:773
msgid "double click character to add here"
msgstr "κάντε διπλό κλικ στον χαρακτήρα για να τον προσθέσετε εδώ"

#: src/app.rs:800
msgid "Hex:"
msgstr "Δεκ.εξ.:"

#: src/app.rs:826
msgid "Dec:"
msgstr "Δεκ.:"

#: src/app.rs:1181
msgid "Copied to clipboard"
msgstr "Αντιγράφηκε στο πρόχειρο"

#: src/templates/char_find_entry.rs:31
msgid "Find"
msgstr "Εύρεση"

#: src/templates/filter_switch.rs:21
msgid "Filter Unicode pages"
msgstr "Φιλτράρισμα σελίδων Unicode"

#: src/templates/filter_switch.rs:27
msgid "Show only Unicode blocks the selected font supports"
msgstr ""
"Εμφάνιση μόνο των μπλοκ Unicode που υποστηρίζει η επιλεγμένη γραμματοσειρά"

#: src/templates/font_preview_toggle.rs:19
msgid "Show plain font names"
msgstr "Εμφάνιση απλών ονομάτων γραμματοσειράς"

#: src/templates/font_preview_toggle.rs:25
msgid "Preview names using each font"
msgstr "Προεπισκόπηση ονομάτων με κάθε γραμματοσειρά"

#: src/widgets/help_dialog.rs:25
msgid "Font List"
msgstr "Λίστα γραμματοσειρών"

#: src/widgets/help_dialog.rs:27 src/widgets/help_dialog.rs:34
msgid "Use the arrow keys to move the selection."
msgstr "Χρησιμοποιήστε τα πλήκτρα βέλους για να μετακινήσετε την επιλογή."

#: src/widgets/help_dialog.rs:28
msgid "Start typing to find a font by name."
msgstr ""
"Ξεκινήστε να πληκτρολογείτε για να βρείτε μια γραμματοσειρά κατ' όνομα."

#: src/widgets/help_dialog.rs:32
msgid "Grid"
msgstr "Πλέγμα"

#: src/widgets/help_dialog.rs:35
msgid ""
"Double-click, or press Enter, to add the selected character to the "
"collection box."
msgstr ""
"Κάντε διπλό κλικ ή πατήστε Enter για να προσθέσετε τον επιλεγμένο χαρακτήρα "
"στο πλαίσιο συλλογής."

#: src/widgets/help_dialog.rs:36
msgid "Press Ctrl+C to copy the selected character to the clipboard."
msgstr ""
"Πατήστε Ctrl+C για να αντιγράψετε τον επιλεγμένο χαρακτήρα στο πρόχειρο."

#: src/widgets/help_dialog.rs:37
msgid ""
"If a character is not present in the selected font, it will be shown as a "
"tofu box with a different background."
msgstr ""
"Αν ένας χαρακτήρας δεν υπάρχει στην επιλεγμένη γραμματοσειρά, θα εμφανιστεί "
"ως πλαίσιο tofu με διαφορετικό φόντο."

#: src/widgets/help_dialog.rs:41
msgid "Hex and Dec Entries"
msgstr "Πεδία δεκαεξαδικού και δεκαδικού"

#: src/widgets/help_dialog.rs:42
msgid ""
"Enter a hex value, a decimal value, or a character, then press Enter to find "
"it."
msgstr ""
"Εισαγάγετε μια δεκαεξαδική τιμή, μια δεκαδική τιμή ή έναν χαρακτήρα και "
"πατήστε Enter για να τον βρείτε."

#: src/widgets/help_dialog.rs:45
msgid "Search"
msgstr "Αναζήτηση"

#: src/widgets/help_dialog.rs:47
msgid "Click the search icon to open the search bar."
msgstr ""
"Κάντε κλικ στο εικονίδιο αναζήτησης για να ανοίξετε τη γραμμή αναζήτησης."

#: src/widgets/help_dialog.rs:48
msgid "Type a character's name to find every character whose name contains it."
msgstr ""
"Πληκτρολογήστε το όνομα ενός χαρακτήρα για να βρείτε όλους τους χαρακτήρες "
"των οποίων το όνομα το περιέχει."

#: src/widgets/help_dialog.rs:49
msgid "Type, or paste, a single character to find it directly."
msgstr ""
"Πληκτρολογήστε ή επικολλήστε έναν μόνο χαρακτήρα για να τον βρείτε απευθείας."

#: src/widgets/help_dialog.rs:88
msgid "Help"
msgstr "Βοήθεια"
