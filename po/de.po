msgid "Search results ({})"
msgstr "Suchergebnisse ({})"

#: src/app.rs:501
msgid "_Help"
msgstr "_Hilfe"

#: src/app.rs:502
msgid "_About"
msgstr "_Info"

#: src/app.rs:526
msgid "Fonts"
msgstr "Schriftarten"

#: src/app.rs:546
msgid "Search fonts…"
msgstr "Schriftarten suchen…"

#: src/app.rs:558
msgid "Show plain font names"
msgstr "Einfache Schriftnamen anzeigen"

#: src/app.rs:571
msgid "Preview names using each font"
msgstr "Namen in der jeweiligen Schriftart anzeigen"

#: src/app.rs:616
msgid "Filter Unicode pages"
msgstr "Unicode-Seiten filtern"

#: src/app.rs:623
msgid "Show only Unicode blocks the selected font supports"
msgstr "Nur Unicode-Blöcke anzeigen, die die gewählte Schriftart unterstützt"

#: src/app.rs:645
msgid "Single letter or character name"
msgstr "Einzelner Buchstabe oder Zeichenname"

#: src/app.rs:734
msgid "Character Information"
msgstr "Zeicheninformationen"

#: src/app.rs:750
msgid "Jump to Unicode Set"
msgstr "Zu Unicode-Bereich springen"

#: src/app.rs:778
msgid "double click character to add here"
msgstr "Zeichen per Doppelklick hier hinzufügen"

#: src/app.rs:803
msgid "Hex:"
msgstr "Hex:"

#: src/app.rs:821 src/app.rs:854
msgid "Find"
msgstr "Suchen"

#: src/app.rs:836
msgid "Dec:"
msgstr "Dez:"

#: src/app.rs:1203
msgid "Copied to clipboard"
msgstr "In die Zwischenablage kopiert"

#: src/widgets/help_dialog.rs:25
msgid "Font List"
msgstr "Schriftartenliste"

#: src/widgets/help_dialog.rs:27 src/widgets/help_dialog.rs:34
msgid "Use the arrow keys to move the selection."
msgstr "Verwenden Sie die Pfeiltasten, um die Auswahl zu bewegen."

#: src/widgets/help_dialog.rs:28
msgid "Start typing to find a font by name."
msgstr "Beginnen Sie mit der Eingabe, um eine Schriftart nach Namen zu finden."

#: src/widgets/help_dialog.rs:32
msgid "Grid"
msgstr "Raster"

#: src/widgets/help_dialog.rs:35
msgid ""
"Double-click, or press Enter, to add the selected character to the "
"collection box."
msgstr ""
"Doppelklicken Sie, oder drücken Sie die Eingabetaste, um das ausgewählte "
"Zeichen dem Sammelfeld hinzuzufügen."

#: src/widgets/help_dialog.rs:36
msgid "Press Ctrl+C to copy the selected character to the clipboard."
msgstr "Drücken Sie Strg+C, um das ausgewählte Zeichen in die Zwischenablage zu kopieren."

#: src/widgets/help_dialog.rs:37
msgid ""
"If a character is not present in the selected font, it will be shown as a "
"tofu box."
msgstr ""
"Wenn ein Zeichen in der ausgewählten Schriftart nicht vorhanden ist, wird es "
"als Tofu-Box angezeigt."

#: src/widgets/help_dialog.rs:41
msgid "Hex and Dec Entries"
msgstr "Hex- und Dezimalfelder"

#: src/widgets/help_dialog.rs:42
msgid ""
"Enter a hex value, a decimal value, or a character, then press Enter to find "
"it."
msgstr ""
"Geben Sie einen Hex-Wert, einen Dezimalwert oder ein Zeichen ein und drücken "
"Sie die Eingabetaste, um es zu finden."

#: src/widgets/help_dialog.rs:45
msgid "Search"
msgstr "Suche"

#: src/widgets/help_dialog.rs:47
msgid "Click the search icon to open the search bar."
msgstr "Klicken Sie auf das Suchsymbol, um die Suchleiste zu öffnen."

#: src/widgets/help_dialog.rs:48
msgid "Type a character's name to find every character whose name contains it."
msgstr ""
"Geben Sie den Namen eines Zeichens ein, um alle Zeichen zu finden, deren "
"Name ihn enthält."

#: src/widgets/help_dialog.rs:49
msgid "Type, or paste, a single character to find it directly."
msgstr ""
"Geben Sie ein einzelnes Zeichen ein oder fügen Sie es ein, um es direkt zu "
"finden."

#: src/widgets/help_dialog.rs:88
msgid "Help"
msgstr "Hilfe"
